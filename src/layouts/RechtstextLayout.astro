---
import BaseLayout from './BaseLayout.astro';

interface Props {
  titel: string;
  beschreibung: string;
  stand?: string;
}

const { titel, beschreibung, stand = 'September 2026' } = Astro.props;
---

<BaseLayout titel={titel} beschreibung={beschreibung}>
  <article class="abschnitt recht">
    <div class="container">
      <header class="recht__kopf">
        <p class="kapitaelchen">Rechtliches</p>
        <h1>{titel}</h1>
      </header>

      <aside class="recht__hinweis" role="note">
        <strong>Platzhalter – bitte vor dem Verkaufsstart ersetzen.</strong>
        Dieser Text ist nur ein Gerüst und keine Rechtsberatung. Gelb markierte Stellen müssen ausgefüllt werden. Einen
        rechtssicheren, aktuellen Text bekommst du z. B. über den Händlerbund, die IT-Recht Kanzlei oder eRecht24.
      </aside>

      <div class="prosa">
        <slot />
      </div>

      <p class="recht__stand">Stand: {stand}</p>
    </div>
  </article>
</BaseLayout>

<style>
  .recht__kopf {
    margin-bottom: 1.5rem;
  }

  .recht__hinweis {
    max-width: var(--breite-text);
    margin-bottom: 2.5rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-klein);
    background: color-mix(in srgb, var(--farbe-senf) 18%, var(--farbe-flaeche));
    box-shadow: inset 4px 0 0 var(--farbe-senf);
    font-size: 0.95rem;
  }

  .recht__hinweis strong {
    display: block;
    margin-bottom: 0.25rem;
  }

  .recht__stand {
    margin-top: 3rem;
    color: var(--farbe-tinte-sanft);
    font-size: 0.9rem;
  }
</style>
