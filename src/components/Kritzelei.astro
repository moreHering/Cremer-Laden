---
/** Kleine Kritzeleien ohne Schrift – nur im Footer, bei leeren Zuständen und auf der 404-Seite. */
interface Props {
  art: 'perlen' | 'bluemchen' | 'pinsel' | 'sonne';
  class?: string;
}

const { art, class: klasse } = Astro.props;

const perlen = [
  { x: 23.5, y: 30.3, farbe: 'var(--farbe-rose)' },
  { x: 44.7, y: 38.5, farbe: 'var(--farbe-blau)' },
  { x: 68.1, y: 42.2, farbe: 'var(--farbe-senf)' },
  { x: 92.7, y: 41.5, farbe: 'var(--farbe-gruen)' },
  { x: 117.1, y: 36, farbe: 'var(--farbe-rose)' },
  { x: 140.1, y: 25.7, farbe: 'var(--farbe-blau)' },
];
const blaetter = [0, 72, 144, 216, 288];
const strahlen = Array.from({ length: 8 }, (_, i) => (i * Math.PI) / 4);
---

{
  art === 'perlen' && (
    <svg class:list={['kritzelei', klasse]} viewBox="0 0 160 60" aria-hidden="true" focusable="false">
      <path d="M6 18C40 50 110 52 154 16" class="kritzelei__linie" />
      {perlen.map((p) => (
        <circle cx={p.x} cy={p.y} r="5.2" style={`fill: ${p.farbe}`} class="kritzelei__perle" />
      ))}
    </svg>
  )
}

{
  art === 'bluemchen' && (
    <svg class:list={['kritzelei', klasse]} viewBox="0 0 80 110" aria-hidden="true" focusable="false">
      <path d="M40 48c-2 20 4 38 0 58" class="kritzelei__stiel" />
      <path d="M41 82c11-10 21-8 25-4-8 8-18 10-25 4Z" class="kritzelei__blatt" />
      {blaetter.map((winkel) => (
        <ellipse cx="40" cy="21" rx="8" ry="12.5" transform={`rotate(${winkel} 40 34)`} class="kritzelei__bluete" />
      ))}
      <circle cx="40" cy="34" r="6" style="fill: var(--farbe-senf)" />
    </svg>
  )
}

{
  art === 'pinsel' && (
    <svg class:list={['kritzelei', klasse]} viewBox="0 0 140 64" aria-hidden="true" focusable="false">
      <path d="M18 58c32-7 72-5 112-18" class="kritzelei__schwung" />
      <path d="M10 46 86 20" class="kritzelei__stiel-pinsel" />
      <path d="M86 20l14-5" class="kritzelei__zwinge" />
      <path d="M100 15c10-5 22-7 30-5-6 6-18 10-29 10Z" style="fill: var(--farbe-rot)" />
    </svg>
  )
}

{
  art === 'sonne' && (
    <svg class:list={['kritzelei', klasse]} viewBox="0 0 80 80" aria-hidden="true" focusable="false">
      <circle cx="40" cy="40" r="13" style="fill: var(--farbe-senf)" />
      {strahlen.map((w) => (
        <path
          d={`M${40 + Math.cos(w) * 20} ${40 + Math.sin(w) * 20}L${40 + Math.cos(w) * 30} ${40 + Math.sin(w) * 30}`}
          class="kritzelei__strahl"
        />
      ))}
    </svg>
  )
}

<style>
  .kritzelei {
    pointer-events: none;
    user-select: none;
  }

  .kritzelei__linie {
    fill: none;
    stroke: var(--farbe-tinte-sanft);
    stroke-width: 1.4;
    stroke-linecap: round;
    opacity: 0.6;
  }

  .kritzelei__perle {
    stroke: var(--farbe-tinte);
    stroke-width: 0.8;
    stroke-opacity: 0.35;
  }

  .kritzelei__stiel {
    fill: none;
    stroke: var(--farbe-gruen);
    stroke-width: 2.6;
    stroke-linecap: round;
  }

  .kritzelei__blatt {
    fill: var(--farbe-gruen);
    opacity: 0.75;
  }

  .kritzelei__bluete {
    fill: var(--farbe-rose);
    stroke: var(--farbe-rot);
    stroke-width: 1.1;
    stroke-opacity: 0.6;
  }

  .kritzelei__schwung {
    fill: none;
    stroke: var(--farbe-blau);
    stroke-width: 3.2;
    stroke-linecap: round;
    opacity: 0.8;
  }

  .kritzelei__stiel-pinsel {
    fill: none;
    stroke: var(--farbe-tinte-sanft);
    stroke-width: 5;
    stroke-linecap: round;
  }

  .kritzelei__zwinge {
    fill: none;
    stroke: #b9b2a6;
    stroke-width: 7;
  }

  .kritzelei__strahl {
    fill: none;
    stroke: var(--farbe-senf);
    stroke-width: 3;
    stroke-linecap: round;
  }
</style>
