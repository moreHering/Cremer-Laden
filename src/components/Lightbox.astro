---
/** Vollbild-Ansicht mit dem ungeschnittenen Foto. Geöffnet über Elemente mit data-lightbox-oeffnen. */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  bilder: { bild: ImageMetadata; alt: string }[];
  titel: string;
}

const { bilder, titel } = Astro.props;
const mehrere = bilder.length > 1;
---

<dialog class="lightbox" data-lightbox aria-label={`Fotos: ${titel}`}>
  <div class="lightbox__kopf">
    <p class="lightbox__zaehler" data-lightbox-zaehler aria-live="polite">
      {mehrere ? `1 / ${bilder.length}` : ''}
    </p>
    <form method="dialog">
      <button class="lightbox__knopf" autofocus>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"></path></svg>
        <span class="visually-hidden">Schließen</span>
      </button>
    </form>
  </div>

  <div class="lightbox__buehne" data-lightbox-buehne>
    {
      bilder.map((eintrag, index) => (
        <figure class="lightbox__folie" data-lightbox-folie hidden={index !== 0}>
          <Picture
            src={eintrag.bild}
            alt={eintrag.alt}
            widths={[800, 1200, 1800]}
            sizes="92vw"
            formats={['avif']}
            fallbackFormat="webp"
            loading="lazy"
            decoding="async"
          />
        </figure>
      ))
    }
  </div>

  {
    mehrere && (
      <>
        <button class="lightbox__knopf lightbox__pfeil lightbox__pfeil--zurueck" data-lightbox-zurueck>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M14.5 6l-6 6 6 6" />
          </svg>
          <span class="visually-hidden">Vorheriges Foto</span>
        </button>
        <button class="lightbox__knopf lightbox__pfeil lightbox__pfeil--weiter" data-lightbox-weiter>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M9.5 6l6 6-6 6" />
          </svg>
          <span class="visually-hidden">Nächstes Foto</span>
        </button>
      </>
    )
  }
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');

  if (dialog) {
    const folien = [...dialog.querySelectorAll<HTMLElement>('[data-lightbox-folie]')];
    const zaehler = dialog.querySelector<HTMLElement>('[data-lightbox-zaehler]');
    let index = 0;

    const zeige = (neu: number) => {
      index = (neu + folien.length) % folien.length;
      folien.forEach((folie, i) => (folie.hidden = i !== index));
      if (zaehler && folien.length > 1) zaehler.textContent = `${index + 1} / ${folien.length}`;
    };

    document.querySelectorAll<HTMLElement>('[data-lightbox-oeffnen]').forEach((knopf) => {
      knopf.addEventListener('click', () => {
        zeige(Number(knopf.dataset.lightboxOeffnen ?? 0));
        dialog.showModal();
      });
    });

    dialog.querySelector('[data-lightbox-zurueck]')?.addEventListener('click', () => zeige(index - 1));
    dialog.querySelector('[data-lightbox-weiter]')?.addEventListener('click', () => zeige(index + 1));

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') zeige(index - 1);
      if (event.key === 'ArrowRight') zeige(index + 1);
    });

    // Klick neben das Foto schließt die Ansicht
    dialog.addEventListener('click', (event) => {
      const ziel = event.target as HTMLElement;
      if (ziel === dialog || ziel.matches('[data-lightbox-buehne], [data-lightbox-folie]')) dialog.close();
    });

    // Wischen auf Touch-Geräten
    let startX: number | null = null;
    dialog.addEventListener('pointerdown', (event) => (startX = event.clientX));
    dialog.addEventListener('pointerup', (event) => {
      if (startX === null || folien.length < 2) return;
      const weg = event.clientX - startX;
      if (Math.abs(weg) > 50) zeige(index + (weg < 0 ? 1 : -1));
      startX = null;
    });

    dialog.addEventListener('close', () => {
      document.dispatchEvent(new CustomEvent('lightbox:geschlossen', { detail: index }));
    });
  }
</script>

<style>
  .lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(28 26 33 / 0.95);
    color: #fff;
  }

  .lightbox[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
  }

  .lightbox::backdrop {
    background: transparent;
  }

  :global(html:has(.lightbox[open])) {
    overflow: hidden;
  }

  .lightbox__kopf {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem clamp(0.75rem, 3vw, 1.5rem);
  }

  .lightbox__zaehler {
    margin: 0;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    opacity: 0.8;
  }

  .lightbox__buehne {
    display: grid;
    place-items: center;
    min-height: 0;
    padding: 0 clamp(0.75rem, 7vw, 6rem) clamp(1rem, 3vw, 2rem);
  }

  .lightbox__folie {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    min-height: 0;
    margin: 0;
  }

  .lightbox__folie[hidden] {
    display: none;
  }

  .lightbox__folie :global(img) {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: calc(100dvh - 6.5rem);
    object-fit: contain;
    border-radius: 8px;
  }

  .lightbox__knopf {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.12);
    color: #fff;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .lightbox__knopf:hover {
    background: rgb(255 255 255 / 0.24);
  }

  .lightbox__knopf:focus-visible {
    outline-color: #fff;
  }

  .lightbox__knopf svg {
    width: 1.3rem;
    height: 1.3rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .lightbox__pfeil {
    position: fixed;
    top: 50%;
    translate: 0 -50%;
  }

  .lightbox__pfeil--zurueck {
    left: clamp(0.5rem, 2vw, 1.5rem);
  }

  .lightbox__pfeil--weiter {
    right: clamp(0.5rem, 2vw, 1.5rem);
  }
</style>
