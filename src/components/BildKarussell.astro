---
/** Wischbares 4:5-Karussell wie ein Beitrag mit mehreren Fotos. Klick öffnet die Lightbox. */
import type { ImageMetadata } from 'astro';
import Produktbild from './Produktbild.astro';
import type { Fokus } from '../lib/format';

interface Props {
  bilder: { bild: ImageMetadata; alt: string; bildfokus: Fokus }[];
  titel: string;
  transitionName?: string;
}

const { bilder, titel, transitionName } = Astro.props;
const mehrere = bilder.length > 1;
---

<div class="karussell" data-karussell>
  <div
    class="karussell__spur"
    data-karussell-spur
    tabindex={mehrere ? 0 : undefined}
    role={mehrere ? 'region' : undefined}
    aria-roledescription={mehrere ? 'Karussell' : undefined}
    aria-label={`Fotos: ${titel}`}
    style={transitionName ? `view-transition-name: ${transitionName}` : undefined}
  >
    {
      bilder.map((eintrag, index) => (
        <div
          class="karussell__folie"
          role={mehrere ? 'group' : undefined}
          aria-roledescription={mehrere ? 'Foto' : undefined}
          aria-label={mehrere ? `${index + 1} von ${bilder.length}` : undefined}
        >
          <button
            type="button"
            class="karussell__zoom"
            data-lightbox-oeffnen={index}
            aria-label={`Foto vergrößern: ${eintrag.alt}`}
          >
            <Produktbild
              bild={eintrag.bild}
              alt={eintrag.alt}
              fokus={eintrag.bildfokus}
              schatten={false}
              laden={index === 0 ? 'eager' : 'lazy'}
              sizes="(min-width: 1240px) 600px, (min-width: 900px) 50vw, 92vw"
            />
            <span class="karussell__lupe" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false">
                <circle cx="10.5" cy="10.5" r="6" />
                <path d="M15 15l5 5M10.5 8v5M8 10.5h5" />
              </svg>
            </span>
          </button>
        </div>
      ))
    }
  </div>

  {
    mehrere && (
      <>
        <button type="button" class="karussell__pfeil karussell__pfeil--zurueck" data-karussell-zurueck>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M14.5 6l-6 6 6 6" />
          </svg>
          <span class="visually-hidden">Vorheriges Foto</span>
        </button>
        <button type="button" class="karussell__pfeil karussell__pfeil--weiter" data-karussell-weiter>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M9.5 6l6 6-6 6" />
          </svg>
          <span class="visually-hidden">Nächstes Foto</span>
        </button>
        <div class="karussell__punkte">
          {bilder.map((_, index) => (
            <button
              type="button"
              class="karussell__punkt"
              data-karussell-punkt={index}
              aria-current={index === 0 ? 'true' : undefined}
            >
              <span class="visually-hidden">Foto {index + 1} anzeigen</span>
            </button>
          ))}
        </div>
      </>
    )
  }
</div>

<script>
  for (const karussell of document.querySelectorAll<HTMLElement>('[data-karussell]')) {
    const spur = karussell.querySelector<HTMLElement>('[data-karussell-spur]');
    if (!spur || spur.children.length < 2) continue;

    const folien = [...spur.children] as HTMLElement[];
    const punkte = [...karussell.querySelectorAll<HTMLButtonElement>('[data-karussell-punkt]')];
    const zurueck = karussell.querySelector<HTMLButtonElement>('[data-karussell-zurueck]');
    const weiter = karussell.querySelector<HTMLButtonElement>('[data-karussell-weiter]');
    const ruhig = matchMedia('(prefers-reduced-motion: reduce)');
    let aktuell = 0;

    const gehe = (index: number, sofort = false) => {
      const ziel = Math.max(0, Math.min(folien.length - 1, index));
      spur.scrollTo({ left: folien[ziel].offsetLeft, behavior: sofort || ruhig.matches ? 'auto' : 'smooth' });
    };

    const aktualisiere = () => {
      aktuell = Math.round(spur.scrollLeft / spur.clientWidth);
      punkte.forEach((punkt, index) => {
        if (index === aktuell) punkt.setAttribute('aria-current', 'true');
        else punkt.removeAttribute('aria-current');
      });
      if (zurueck) zurueck.disabled = aktuell === 0;
      if (weiter) weiter.disabled = aktuell === folien.length - 1;
    };

    let geplant = false;
    spur.addEventListener(
      'scroll',
      () => {
        if (geplant) return;
        geplant = true;
        requestAnimationFrame(() => {
          aktualisiere();
          geplant = false;
        });
      },
      { passive: true },
    );

    zurueck?.addEventListener('click', () => gehe(aktuell - 1));
    weiter?.addEventListener('click', () => gehe(aktuell + 1));
    punkte.forEach((punkt, index) => punkt.addEventListener('click', () => gehe(index)));

    spur.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault();
        gehe(aktuell + (event.key === 'ArrowRight' ? 1 : -1));
      }
    });

    // Nach dem Schließen der Lightbox beim zuletzt angesehenen Foto weitermachen
    document.addEventListener('lightbox:geschlossen', (event) => {
      gehe((event as CustomEvent<number>).detail, true);
    });

    aktualisiere();
  }
</script>

<style>
  .karussell {
    position: relative;
  }

  .karussell__spur {
    position: relative;
    display: flex;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: var(--radius-bild);
    box-shadow: var(--schatten-bild);
    background: var(--farbe-linie);
  }

  .karussell__spur::-webkit-scrollbar {
    display: none;
  }

  .karussell__folie {
    flex: 0 0 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .karussell__zoom {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .karussell__zoom:focus-visible {
    outline-offset: -4px;
  }

  .karussell__lupe {
    position: absolute;
    right: 0.9rem;
    bottom: 0.9rem;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.88);
    box-shadow: 0 2px 10px rgb(43 40 51 / 0.15);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .karussell__zoom:hover .karussell__lupe,
  .karussell__zoom:focus-visible .karussell__lupe {
    opacity: 1;
  }

  @media (hover: none) {
    .karussell__lupe {
      opacity: 1;
    }
  }

  .karussell__lupe svg,
  .karussell__pfeil svg {
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: var(--farbe-tinte);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .karussell__pfeil {
    position: absolute;
    top: 50%;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.92);
    box-shadow: 0 2px 12px rgb(43 40 51 / 0.16);
    cursor: pointer;
    translate: 0 -50%;
    transition:
      opacity 0.2s,
      transform 0.2s var(--kurve);
  }

  .karussell__pfeil:hover {
    transform: scale(1.06);
  }

  .karussell__pfeil:disabled {
    opacity: 0;
    pointer-events: none;
  }

  .karussell__pfeil--zurueck {
    left: 0.8rem;
  }

  .karussell__pfeil--weiter {
    right: 0.8rem;
  }

  .karussell__punkte {
    display: flex;
    justify-content: center;
    gap: 0.25rem;
    margin-top: 0.9rem;
  }

  .karussell__punkt {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .karussell__punkt::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--farbe-linie);
    transition:
      background-color 0.2s,
      transform 0.2s;
  }

  .karussell__punkt[aria-current='true']::before {
    background: var(--farbe-tinte);
    transform: scale(1.15);
  }
</style>
